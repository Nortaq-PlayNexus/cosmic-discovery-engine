# Secrets — never commit. .env.example is the committed template.
.env
.env.*
!.env.example

# Runtime data: SQLite database, cached/downloaded light curves, logs.
# These are regenerable and can be hundreds of MB.
data/
*.db
*.db-wal
*.db-shm
*.log
npz_cache/

