# Cosmic Discovery Engine configuration
# Copy to .env and adjust as needed

# Data directory (where SQLite DB and downloaded data live)
CDE_DATA_DIR=./data

# NASA Exoplanet Archive TAP endpoint
CDE_EXOPLANET_ARCHIVE_URL=https://exoplanetarchive.ipac.caltech.edu/TAP/sync

# MAST API token (optional — increases rate limits)
# Get one at https://auth.mast.stsci.edu/
CDE_MAST_TOKEN=

# Gaia archive endpoint
CDE_GAIA_URL=https://gea.esac.esa.int/tap-server/tap/sync

# Logging: DEBUG, INFO, WARNING, ERROR
CDE_LOG_LEVEL=INFO

# Dashboard
CDE_DASHBOARD_HOST=127.0.0.1
CDE_DASHBOARD_PORT=5050
